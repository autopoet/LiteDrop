# Caddy uses HTTP locally. Replace with a real domain in production, for example:
# SITE_ADDRESS=files.example.com
SITE_ADDRESS=http://localhost

APP_NAME=CodeDrop
APP_ENV=development
# Production refuses placeholder secrets; generate two independent 32+ character values.
APP_SECRET=change-me-use-a-long-random-value
DOWNLOAD_SECRET=change-me-use-another-long-random-value

# These paths are inside the backend container.
DATABASE_PATH=/app/data/codedrop.db
STORAGE_ROOT=/app/storage

# Upload limits: 5 MiB chunks, 200 MiB per file, 5 GiB total storage.
CHUNK_SIZE_BYTES=5242880
MAX_CHUNK_SIZE_BYTES=6291456
MAX_FILE_SIZE_BYTES=209715200
STORAGE_QUOTA_BYTES=5368709120
DISK_RESERVE_BYTES=2147483648

UPLOAD_SESSION_TTL_MINUTES=120
DEFAULT_SHARE_EXPIRE_HOURS=6
MAX_SHARE_EXPIRE_HOURS=24
DOWNLOAD_TICKET_TTL_MINUTES=30
MAX_DOWNLOAD_LIMIT=5

# Public deployments must keep an upload access code enabled.
PUBLIC_UPLOAD_ENABLED=true
# This value cannot be empty when APP_ENV=production.
UPLOAD_ACCESS_CODE=change-me-upload-code

ADMIN_USERNAME=admin
# Store a password hash, never a plaintext production password.
# Keep the single quotes when the generated hash contains "$".
ADMIN_PASSWORD_HASH='change-me-password-hash'
ADMIN_TOKEN_EXPIRE_HOURS=8

# Use the browser origin. Production example: https://files.example.com
ALLOWED_ORIGINS=http://localhost
CLEANUP_INTERVAL_MINUTES=30
